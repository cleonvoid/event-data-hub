rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOrgMember(orgId) {
      return isSignedIn() && (
        orgId == request.auth.uid ||
        orgId == 'org_local_dev' ||
        (request.auth.token.keys().hasAll(['org_id']) && request.auth.token.org_id == orgId) ||
        (request.auth.token.keys().hasAll(['organization_id']) && request.auth.token.organization_id == orgId)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /organizations/{orgId} {
      allow get, list: if isOrgMember(orgId);

      match /canonical_entities/{entityId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgMember(orgId) && isValidId(entityId);
      }

      match /raw_records/{recordId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgMember(orgId) && isValidId(recordId);
      }

      match /merge_suggestions/{suggestionId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgMember(orgId) && isValidId(suggestionId);
      }

      match /sources/{sourceId} {
        allow read: if isOrgMember(orgId);
        allow create, update, delete: if isOrgMember(orgId) && isValidId(sourceId);
      }
    }
  }
}
