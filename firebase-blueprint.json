{
  "entities": {
    "CanonicalEntity": {
      "title": "CanonicalEntity",
      "description": "Deduplicated canonical entity representing an individual across event records",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 256 },
        "primaryEmail": { "type": "string", "maxLength": 256 },
        "primaryPhone": { "type": "string", "maxLength": 64 },
        "primaryOrganization": { "type": "string", "maxLength": 256 },
        "primaryRole": { "type": "string", "maxLength": 256 },
        "eventCount": { "type": "integer" },
        "sourceFileCount": { "type": "integer" },
        "recordCount": { "type": "integer" },
        "createdAt": { "type": "string" },
        "organizationId": { "type": "string", "maxLength": 128 }
      },
      "required": ["displayName", "organizationId"]
    },
    "RawRecord": {
      "title": "RawRecord",
      "description": "Raw record imported from spreadsheet rows",
      "type": "object",
      "properties": {
        "sourceId": { "type": "string", "maxLength": 128 },
        "sourceName": { "type": "string", "maxLength": 256 },
        "sourceType": { "type": "string", "maxLength": 64 },
        "rowNumber": { "type": "integer" },
        "fullName": { "type": "string", "maxLength": 256 },
        "organization": { "type": "string", "maxLength": 256 },
        "roleTitle": { "type": "string", "maxLength": 256 },
        "email": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "eventName": { "type": "string", "maxLength": 256 },
        "eventDate": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string" },
        "organizationId": { "type": "string", "maxLength": 128 }
      },
      "required": ["sourceId", "organizationId"]
    },
    "MergeSuggestion": {
      "title": "MergeSuggestion",
      "description": "Candidate merge suggestion generated by vector matching and LLM adjudication",
      "type": "object",
      "properties": {
        "canonicalEntityId": { "type": "string", "maxLength": 128 },
        "candidateRawRecordId": { "type": "string", "maxLength": 128 },
        "vectorSimilarity": { "type": "number" },
        "llmConfidence": { "type": "number" },
        "combinedConfidence": { "type": "number" },
        "llmVerdict": { "type": "boolean" },
        "reasoning": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "organizationId": { "type": "string", "maxLength": 128 }
      },
      "required": ["canonicalEntityId", "candidateRawRecordId", "status", "organizationId"]
    },
    "SourceRow": {
      "title": "SourceRow",
      "description": "Imported source spreadsheet file",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "sourceType": { "type": "string", "maxLength": 64 },
        "externalFileId": { "type": "string", "maxLength": 256 },
        "importedAt": { "type": "string" },
        "recordsCount": { "type": "integer" },
        "organizationId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "sourceType", "organizationId"]
    }
  },
  "firestore": {
    "/organizations/{orgId}/canonical_entities/{entityId}": {
      "schema": { "$ref": "#/entities/CanonicalEntity" },
      "description": "Canonical entities for an organization"
    },
    "/organizations/{orgId}/raw_records/{recordId}": {
      "schema": { "$ref": "#/entities/RawRecord" },
      "description": "Raw records for an organization"
    },
    "/organizations/{orgId}/merge_suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/MergeSuggestion" },
      "description": "Merge suggestions for an organization"
    },
    "/organizations/{orgId}/sources/{sourceId}": {
      "schema": { "$ref": "#/entities/SourceRow" },
      "description": "Source files for an organization"
    }
  }
}
