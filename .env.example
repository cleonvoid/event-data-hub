# ---------------------------------------------------------------------------
# Event Data Hub — copy to .env and fill in. Nothing here is committed.
# ---------------------------------------------------------------------------

# HTTP port. Cloud Run injects this automatically; do not hardcode it there.
PORT=3000

# Postgres. docker-compose publishes on host port 5433 to avoid clashing with a
# local Postgres on 5432.
# Cloud SQL via the Cloud Run socket looks like:
#   postgres://USER:PASS@/event_data_hub?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/event_data_hub

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id used for schema mapping, merge adjudication and NL search.
# Verified once at startup — if it 404s, the boot log tells you to change this.
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Embeddings (Stage 1 candidate retrieval)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=gemini-embedding-001
# Must match the VECTOR(n) width in migrations/000001_init.up.sql.
EMBEDDING_DIM=768

# Locally this is false: embeddings go through the Gemini API with GEMINI_API_KEY.
# On Cloud Run set it to true to use Vertex AI with the service account's ADC —
# same model, no API key in the environment.
USE_VERTEX_EMBEDDINGS=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# dev      — no token required, everything is scoped to DEV_ORG_ID.
#            Refused when NODE_ENV=production.
# firebase — verifies real Firebase ID tokens.
AUTH_MODE=dev
DEV_ORG_ID=org_local_dev
DEV_EMAIL=dev@localhost

# Required when AUTH_MODE=firebase.
FIREBASE_PROJECT_ID=
# Optional: only needed for privileged Admin SDK calls, not for token verification.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Firebase web config — consumed by the browser, so these must be VITE_-prefixed.
# Safe to expose; they identify the project, they do not authorise anything.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Entity resolution tuning
# ---------------------------------------------------------------------------
# How many canonical entities Stage 1 retrieves per new record.
RESOLUTION_TOP_N=5
# Cosine similarity floor before a candidate is worth a Gemini call.
RESOLUTION_MIN_SIMILARITY=0.55
# Blended score floor before a suggestion is shown to the user.
RESOLUTION_MIN_COMBINED=0.5
